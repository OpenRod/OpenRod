{
  "name": "openshell-console",
  "version": "0.1.0",
  "description": "A local console for OpenShell gateways, sandboxes, and activity.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "openshell-console": "./server/cli.js"
  },
  "files": [
    "dist/",
    "server/*.js",
    "server/*.cjs",
    "server/*.py",
    "shared/*.js",
    "shared/*.json",
    "src/lib/*.js",
    "vendor/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SETUPS.md",
    "!**/*.test.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "OPENROD_BUILD=1 vite build",
    "start": "node --env-file-if-exists=.env server/start.js",
    "start:local": "node ./server/cli.js",
    "preview": "node ./server/cli.js",
    "test": "node --test server/*.test.js src/lib/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "connect": "^3.7.0",
    "fflate": "^0.8.2",
    "firebase-admin": "^14.5.0",
    "serve-static": "^2.2.1",
    "smol-toml": "^1.6.0",
    "@nvidia/openshell-sdk": "file:vendor/nvidia-openshell-sdk-0.0.0.tgz",
    "ws": "^8.22.0"
  },
  "bundleDependencies": [
    "@nvidia/openshell-sdk"
  ],
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@bufbuild/protobuf": "2.15.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "firebase": "^12.19.0",
    "lucide-react": "^0.577.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1"
  }
}
