{
  "name": "openrod",
  "version": "0.2.0",
  "description": "A local console for OpenShell gateways, sandboxes, and activity.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/OpenRod/OpenRod#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenRod/OpenRod.git",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/OpenRod/OpenRod/issues"
  },
  "keywords": [
    "openshell",
    "sandbox",
    "ai-agents",
    "mcp",
    "console"
  ],
  "type": "module",
  "bin": {
    "openrod": "server/cli.js"
  },
  "files": [
    "dist/",
    "server/*.js",
    "server/*.cjs",
    "server/*.py",
    "shared/*.js",
    "shared/*.json",
    "src/lib/*.js",
    "vendor/",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SETUPS.md",
    "!**/*.test.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "OPENROD_BUILD=1 vite build",
    "start": "node --env-file-if-exists=.env server/start.js",
    "start:local": "node ./server/cli.js",
    "preview": "node ./server/cli.js",
    "test": "node --test server/*.test.js src/lib/*.test.js",
    "notices": "node scripts/third-party-notices.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nvidia/openshell-sdk": "file:vendor/nvidia-openshell-sdk-0.0.0.tgz",
    "connect": "^3.7.0",
    "fflate": "^0.8.3",
    "serve-static": "^2.2.1",
    "smol-toml": "^1.9.0",
    "ws": "^8.22.0"
  },
  "bundleDependencies": [
    "@nvidia/openshell-sdk"
  ],
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@bufbuild/protobuf": "2.15.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "firebase": "12.19.0",
    "lucide-react": "^0.577.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    }
  }
}
