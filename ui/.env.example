# Account-free local use.
OPENROD_MODE=local
OPENROD_PORT=4600

# Hosted Cloud is available by default. Override the URL below, or set it empty to disable Cloud.
# This is runtime configuration; rebuilding the frontend is not required.
# OPENROD_CLOUD_ORIGIN=https://console.openrod.io

# Cloud control plane: see deploy/gcp/README.md for prerequisites and deployment.
# OPENROD_MODE=cloud
# GOOGLE_CLOUD_PROJECT=your-project
# OPENROD_ORG_ID=your-org
# OPENROD_PUBLIC_ORIGIN=https://console.openrod.io
# OPENROD_FIREBASE_API_KEY=your-public-web-api-key
# OPENROD_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# OPENROD_FIRESTORE_DATABASE=openrod-cloud
# OPENROD_MAX_MACHINES=10
# OPENROD_WORKER_ZONE=us-east1-b
# OPENROD_WORKER_SUBNET=projects/your-project/regions/us-east1/subnetworks/your-subnet
# OPENROD_WORKER_ARTIFACT_ORIGIN=http://10.80.0.2:8080
# OPENROD_WORKER_ARTIFACT=/var/lib/openrod/worker-app.tar.gz
# OPENROD_WORKER_ARTIFACT_SHA256=sha256-of-reviewed-artifact
# OPENSHELL_CONSOLE_DATA_DIR=/var/lib/openrod/console-state
