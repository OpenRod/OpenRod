diff --git a/crates/openshell-driver-vm/scripts/test-loopback-hosts.sh b/crates/openshell-driver-vm/scripts/test-loopback-hosts.sh
new file mode 100755
index 0000000..6d96aa6
--- /dev/null
+++ b/crates/openshell-driver-vm/scripts/test-loopback-hosts.sh
@@ -0,0 +1,55 @@
+#!/bin/bash
+# SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+# Run on Linux (the guest platform), with bash, awk and coreutils.
+set -euo pipefail
+script_dir=$(cd "$(dirname "$0")" && pwd)
+eval "$(sed -n '/^configure_loopback_hosts() {/,/^}/p' "$script_dir/openshell-vm-sandbox-init.sh")"
+test_root=$(mktemp -d)
+trap 'rm -rf "$test_root"' EXIT
+mkdir "$test_root/etc"
+root_path() { printf '%s%s' "$test_root" "$1"; }
+
+# Missing and empty hosts files, as produced by Docker image export.
+for state in missing empty; do
+    rm -f "$test_root/etc/hosts"
+    if [ "$state" = empty ]; then touch "$test_root/etc/hosts"; fi
+    configure_loopback_hosts
+    grep -qx '127.0.0.1 localhost' "$test_root/etc/hosts"
+    grep -qx '::1 localhost ip6-localhost ip6-loopback' "$test_root/etc/hosts"
+    [ "$(stat -c %a "$test_root/etc/hosts")" = 644 ]
+done
+
+# Keep custom aliases while removing conflicting localhost destinations.
+cat >"$test_root/etc/hosts" <<'EOF'
+# image aliases
+10.0.0.5 service.internal
+203.0.113.4 LOCALHOST custom-alias # retain alias
+::1 localhost ip6-loopback
+EOF
+configure_loopback_hosts
+grep -qx '10.0.0.5 service.internal' "$test_root/etc/hosts"
+grep -qx '203.0.113.4 custom-alias # retain alias' "$test_root/etc/hosts"
+[ "$(grep -c 'localhost' "$test_root/etc/hosts")" = 2 ]
+cp "$test_root/etc/hosts" "$test_root/expected"
+configure_loopback_hosts
+cmp "$test_root/expected" "$test_root/etc/hosts"
+
+# Never copy privileged symlink targets into the world-readable hosts file.
+printf 'private sentinel\n' >"$test_root/private"
+rm "$test_root/etc/hosts"
+ln -s "$test_root/private" "$test_root/etc/hosts"
+configure_loopback_hosts
+[ ! -L "$test_root/etc/hosts" ]
+! grep -q sentinel "$test_root/etc/hosts"
+grep -qx 'private sentinel' "$test_root/private"
+
+# A non-file destination must fail instead of silently writing into a directory.
+rm "$test_root/etc/hosts"
+mkdir "$test_root/etc/hosts"
+if (configure_loopback_hosts) 2>/dev/null; then
+    echo 'Directory destination unexpectedly accepted' >&2
+    exit 1
+fi
+echo 'Loopback hosts regression checks passed'
