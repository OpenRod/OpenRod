+configure_loopback_hosts() {
+    # Docker exports may contain an empty /etc/hosts even when the image has
+    # entries. Reconcile after the workload rootfs is mounted, on every boot,
+    # so localhost never depends on the policy-mediated DNS relay.
+    local hosts temporary
+    hosts="$(root_path /etc/hosts)"
+    temporary=$(mktemp "$(root_path /etc)/.openshell-hosts.XXXXXX")
+    # Do not read an image-controlled symlink as guest root: its target could
+    # contain privileged data that must not be copied into a public hosts file.
+    if [ -f "$hosts" ] && [ ! -L "$hosts" ]; then
+        awk '
+            /^[[:space:]]*#/ || NF < 2 { print; next }
+            {
+                line = $1
+                aliases = 0
+                for (i = 2; i <= NF; i++) {
+                    if ($i ~ /^#/) break
+                    alias = tolower($i)
+                    if (alias != "localhost" && alias != "ip6-localhost" && alias != "ip6-loopback") {
+                        line = line " " $i
+                        aliases++
+                    }
+                }
+                if (aliases) {
+                    for (; i <= NF; i++) line = line " " $i
+                    print line
+                }
+            }
+        ' "$hosts" >"$temporary"
+    fi
+    cat >>"$temporary" <<'EOF'
+127.0.0.1 localhost
+::1 localhost ip6-localhost ip6-loopback
+EOF
+    chmod 0644 "$temporary"
+    mv -fT "$temporary" "$hosts"
+}
